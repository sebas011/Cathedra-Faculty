    "@testing-library/react": "16.3.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "axe-core": "4.13.0",
    "eslint": "^10.12.0",
    "jsdom": "26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.7",
    "vitest": "4.1.11"
  }
